   "source": [
    "string1 = \"Hello \"\n",
    "string2 = input(\"Enter your name: \")\n",
    "string3 = \", welcome to Python programming\"\n",
    "\n",
    "result = string1 + string2 + string3\n",
    "\n",
    "# a. First character\n",
    "print(\"a.\", result[0])\n",
    "\n",
    "# b. Last character\n",
    "print(\"b.\", result[-1])\n",
    "\n",
    "# c. First 5 characters\n",
    "print(\"c.\", result[:5])\n",
    "\n",
    "# d. Last 11 characters\n",
    "print(\"d.\", result[-11:])\n",
    "\n",
    "# e. String in reverse\n",
    "print(\"e.\", result[::-1])\n",
    "\n",
    "# f. The word \"Python\"\n",
    "start = result.index(\"Python\")\n",
    "print(\"f.\", result[start:start + 6])"
   ]
